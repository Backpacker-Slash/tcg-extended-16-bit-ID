; Builds the current Card Album set by scanning every valid card ID.
; wFilteredCardList and wOwnedCardsCountList hold only the current 80-row window.
; wNumCardListEntries is a temporary 16-bit total during the scan; at the end it
; becomes the number of rows visible in the Album (through the last owned card).
; input: a = CARD_SET_* constant
CreateCardSetList:
	ld [wSelectedCardSet], a
	push af
	push bc
	push de
	push hl

; clear the 80-row ID window and initialize its status sidecar to NOT OWNED
	ld a, (MAX_NUM_CARDS_PER_TYPE + 1) * 2
	ld hl, wFilteredCardList
	call ClearMemory_Bank2
	ld hl, wOwnedCardsCountList
	ld b, MAX_NUM_CARDS_PER_TYPE + 1
	ld a, CARD_NOT_OWNED
.loop_clear_status
	ld [hli], a
	dec b
	jr nz, .loop_clear_status

; reset 16-bit counters and set the first-owned sentinel to $ffff
	xor a
	ld [wNumCardListEntries], a
	ld [wNumCardListEntriesHigh], a
	ld [wNumEntriesInCurFilter], a
	ld [wNumEntriesInCurFilterHigh], a
	ld [wNumOwnedCardsInSet], a
	ld [wNumOwnedCardsInSetHigh], a
	ld [wOwnedPhantomCardFlags], a
	ld a, $ff
	ld [wFirstOwnedCardIndex], a
	ld [wFirstOwnedCardIndexHigh], a

	pop hl
	pop de
	pop bc
	pop af

; Scan all IDs in ascending order. Card data loading sets carry at NUM_CARDS+1.
	ld de, 0
.loop_all_cards
	inc de
	call LoadCardDataToBuffer1_FromCardID
	jr c, .done_pkmn_cards
	ld a, [wLoadedCard1Set]
	and $f0
	swap a
	ld b, a
	ld a, [wSelectedCardSet]
	cp b
	jp nz, .loop_all_cards

; These two phantom cards are appended at the end, as in the original game.
	ld a, d
	cp HIGH(VENUSAUR_LV64)
	jr nz, .check_mew
	ld a, e
	cp LOW(VENUSAUR_LV64)
	jr z, .check_venusaur_owned
.check_mew
	ld a, d
	cp HIGH(MEW_LV15)
	jr nz, .regular_set_card
	ld a, e
	cp LOW(MEW_LV15)
	jr z, .check_mew_owned

.regular_set_card
	call AppendCardSetEntry
	jp .loop_all_cards

.check_venusaur_owned
	push de
	ld hl, wTempCardCollection + VENUSAUR_LV64
	ld a, [hl]
	cp CARD_NOT_OWNED
	jr z, .venusaur_done
	ld a, [wOwnedPhantomCardFlags]
	or (1 << VENUSAUR_OWNED_PHANTOM_F)
	ld [wOwnedPhantomCardFlags], a
.venusaur_done
	pop de
	jp .loop_all_cards

.check_mew_owned
	push de
	ld hl, wTempCardCollection + MEW_LV15
	ld a, [hl]
	cp CARD_NOT_OWNED
	jr z, .mew_done
	ld a, [wOwnedPhantomCardFlags]
	or (1 << MEW_OWNED_PHANTOM_F)
	ld [wOwnedPhantomCardFlags], a
.mew_done
	pop de
	jp .loop_all_cards

.done_pkmn_cards
; Basic Energy cards belong to Colosseum; Double Colorless belongs to Mystery.
	ld a, [wSelectedCardSet]
	cp CARD_SET_MYSTERY
	jr z, .mystery_energy
	or a
	jr nz, .append_phantoms
	ld de, 0
.loop_basic_energy_cards
	inc e
	ld a, e
	cp LOW(DOUBLE_COLORLESS_ENERGY)
	jr z, .append_phantoms
	call AppendCardSetEntry
	jr .loop_basic_energy_cards

.mystery_energy
	ld de, DOUBLE_COLORLESS_ENERGY
	call AppendCardSetEntry

.append_phantoms
	ld a, [wOwnedPhantomCardFlags]
	bit VENUSAUR_OWNED_PHANTOM_F, a
	jr z, .check_append_mew
	ld de, VENUSAUR_LV64
	call AppendCardSetEntry
.check_append_mew
	ld a, [wOwnedPhantomCardFlags]
	bit MEW_OWNED_PHANTOM_F, a
	jr z, .finish
	ld de, MEW_LV15
	call AppendCardSetEntry

.finish
; Save the true set size separately for the X/Y header.
	ld a, [wNumCardListEntries]
	ld [wNumCardsInSet], a
	ld a, [wNumCardListEntriesHigh]
	ld [wNumCardsInSetHigh], a
	call TrimCardSetWindow
; Navigation length is the prefix ending at the last owned card.
	ld a, [wNumEntriesInCurFilter]
	ld [wNumCardListEntries], a
	ld a, [wNumEntriesInCurFilterHigh]
	ld [wNumCardListEntriesHigh], a
	ret

; Appends the card ID in DE to the logical set list. The row goes into WRAM
; only if its absolute rank is in [offset, offset + 80). Counts every row even
; when it is outside the current window. wTempCardCollection has raw status/counts.
AppendCardSetEntry:
	push af
	push bc
	push de
	push hl
	ld hl, wTempCardCollection
	add hl, de
	ld a, [hl]
	push af ; raw owned/count status

; local rank = total rank - window start, using 16-bit subtraction.
	ld a, [wNumCardListEntries]
	ld b, a
	ld a, [wCardListVisibleOffset]
	ld c, a
	ld a, b
	sub c
	ld l, a
	ld a, [wNumCardListEntriesHigh]
	ld b, a
	ld a, [wCardListVisibleOffsetHigh]
	ld c, a
	ld a, b
	sbc c
	ld h, a
	ld a, h
	or a
	jr nz, .count_entry
	ld a, l
	cp MAX_NUM_CARDS_PER_TYPE
	jr nc, .count_entry

; Store ID and status together at the window-local row.
	ld a, l
	push af ; preserve local row
	add a
	ld c, a
	ld b, 0
	ld hl, wFilteredCardList
	add hl, bc
	ld [hl], e
	inc hl
	ld [hl], d
	pop af
	ld c, a
	ld b, 0
	ld hl, wOwnedCardsCountList
	add hl, bc
	push hl ; sidecar cell
	ld hl, wTempCardCollection
	add hl, de
	ld a, [hl]
	pop hl
	ld [hl], a

.count_entry
	pop af ; raw owned/count status
	push af
; total entries += 1
	ld hl, wNumCardListEntries
	inc [hl]
	jr nz, .total_incremented
	inc hl
	inc [hl]
.total_incremented
	pop af
	cp CARD_NOT_OWNED
	jr z, .done_entry

; Count this owned card (sets count cards, not duplicate copies).
	ld hl, wNumOwnedCardsInSet
	inc [hl]
	jr nz, .owned_total_incremented
	inc hl
	inc [hl]
.owned_total_incremented

; First owned row is an absolute 16-bit rank. $ffff is the unset sentinel.
	ld a, [wFirstOwnedCardIndex]
	cp $ff
	jr nz, .set_visible_end
	ld a, [wFirstOwnedCardIndexHigh]
	cp $ff
	jr nz, .set_visible_end
; When this was the first owned card, total was already incremented;
; its rank is total - 1.
	ld a, [wNumCardListEntries]
	or a
	jr nz, .first_owned_low_nonzero
	ld a, $ff
	ld [wFirstOwnedCardIndex], a
	ld a, [wNumCardListEntriesHigh]
	dec a
	ld [wFirstOwnedCardIndexHigh], a
	jr .set_visible_end
.first_owned_low_nonzero
	dec a
	ld [wFirstOwnedCardIndex], a
	ld a, [wNumCardListEntriesHigh]
	ld [wFirstOwnedCardIndexHigh], a
.set_visible_end
; the displayable list ends immediately after the last owned row
	ld a, [wNumCardListEntries]
	ld [wNumEntriesInCurFilter], a
	ld a, [wNumCardListEntriesHigh]
	ld [wNumEntriesInCurFilterHigh], a
.done_entry
	pop hl
	pop de
	pop bc
	pop af
	ret

; Clear rows beyond the last owned card, and the whole window if it is past
; that point. This preserves the original Card Album's trailing-empty behavior.
TrimCardSetWindow:
	push af
	push bc
	push de
	push hl
; If offset >= visible list length, there are no rows to show in this window.
	ld a, [wNumEntriesInCurFilterHigh]
	ld b, a
	ld a, [wCardListVisibleOffsetHigh]
	cp b
	jr c, .compute_tail
	jr nz, .clear_all
	ld a, [wNumEntriesInCurFilter]
	ld b, a
	ld a, [wCardListVisibleOffset]
	cp b
	jr c, .compute_tail
	jr .clear_all
.compute_tail
; HL = visible length - absolute offset
	ld a, [wNumEntriesInCurFilter]
	ld b, a
	ld a, [wCardListVisibleOffset]
	ld c, a
	ld a, b
	sub c
	ld l, a
	ld a, [wNumEntriesInCurFilterHigh]
	ld b, a
	ld a, [wCardListVisibleOffsetHigh]
	ld c, a
	ld a, b
	sbc c
	ld h, a
	ld a, h
	or a
	jr nz, .done_trim ; at least 256 rows remain; current window is full
	ld a, l
	cp MAX_NUM_CARDS_PER_TYPE
	jr nc, .done_trim
; Clear IDs starting at local row L through row 80.
	ld c, l
	ld a, MAX_NUM_CARDS_PER_TYPE + 1
	sub c
	add a ; bytes to clear in ID list (2 bytes per row)
	push af
	ld a, c
	add a
	ld e, a
	ld d, 0
	ld hl, wFilteredCardList
	add hl, de
	pop af
	call ClearMemory_Bank2
; Mark corresponding sidecar tail as not-owned.
	ld a, c
	ld b, 0
	ld hl, wOwnedCardsCountList
	add hl, bc
	ld a, MAX_NUM_CARDS_PER_TYPE + 1
	sub c
	ld b, a
	ld a, CARD_NOT_OWNED
.loop_clear_tail_status
	ld [hli], a
	dec b
	jr nz, .loop_clear_tail_status
	jr .done_trim
.clear_all
	ld a, (MAX_NUM_CARDS_PER_TYPE + 1) * 2
	ld hl, wFilteredCardList
	call ClearMemory_Bank2
	ld hl, wOwnedCardsCountList
	ld b, MAX_NUM_CARDS_PER_TYPE + 1
	ld a, CARD_NOT_OWNED
.loop_clear_all_status
	ld [hli], a
	dec b
	jr nz, .loop_clear_all_status
.done_trim
	pop hl
	pop de
	pop bc
	pop af
	ret

; a = CARD_SET_* constant
CreateCardSetListAndInitListCoords:
	push af
	ld hl, sCardCollection
	ld de, wTempCardCollection
	ld bc, CARD_COLLECTION_SIZE
	call EnableSRAM
	call CopyNBytesFromHLToDE_Long
	call DisableSRAM
	pop af
	push af
	xor a
	ld [wCardListVisibleOffset], a
	ld [wCardListVisibleOffsetHigh], a
	pop af

	push af
	call .GetEntryPrefix
	call CreateCardSetList
	ld a, NUM_CARD_ALBUM_VISIBLE_CARDS
	ld [wNumVisibleCardListEntries], a
	lb de, 2, 4
	ld hl, wCardListCoords
	ld [hl], e
	inc hl
	ld [hl], d
	pop af
	ret

; places in entry name the prefix associated with the selected Card Set
; a = CARD_SET_* constant
.GetEntryPrefix
	push af
	cp CARD_SET_PROMOTIONAL
	jr nz, .laboratory
	ldfw de, "P"
	jr .got_prefix
.laboratory
	cp CARD_SET_LABORATORY
	jr nz, .mystery
	ldfw de, "D"
	jr .got_prefix
.mystery
	cp CARD_SET_MYSTERY
	jr nz, .evolution
	ldfw de, "C"
	jr .got_prefix
.evolution
	cp CARD_SET_EVOLUTION
	jr nz, .colosseum
	ldfw de, "B"
	jr .got_prefix
.colosseum
	ldfw de, "A"

.got_prefix
	ld hl, wCurDeckName
	ld [hl], d
	inc hl
	ld [hl], e
	pop af
	ret

; prints the cards being shown in the Card Album screen
; for the corresponding Card Set
PrintCardSetListEntries:
	push bc
	ld hl, wCardListCoords
	ld e, [hl]
	inc hl
	ld d, [hl]
	ld b, $13
	ld c, e
	dec c
	dec c

; draw up cursor on top right
	ld a, [wCardListVisibleOffset]
	ld b, a
	ld a, [wCardListVisibleOffsetHigh]
	or b
	jr z, .no_up_cursor
	ld a, SYM_CURSOR_U
	jr .got_up_cursor_tile
.no_up_cursor
	ld a, SYM_BOX_TOP_R
.got_up_cursor_tile
	call WriteByteToBGMap0

	ld hl, 0 ; wFilteredCardList starts at absolute offset
	ld a, [wNumVisibleCardListEntries]
.loop_visible_cards
	push de
	or a
	jr z, .handle_down_cursor
	ld b, a
	ld de, wFilteredCardList
	push hl
	add hl, hl
	add hl, de
	ld a, [hli]
	ld d, [hl]
	ld e, a
	pop hl
	inc l
	or d
	jr z, .no_down_cursor
	call AddCardIDToVisibleList
	call LoadCardDataToBuffer1_FromCardID
	push bc
	push hl
	ld de, wOwnedCardsCountList
	add hl, de
	dec hl
	ld a, [hl]
	cp CARD_NOT_OWNED
	jr nz, .owned
	ld hl, .EmptySlotText
	ld de, wDefaultText
	call CopyListFromHLToDE
	jr .print_text
.owned
	ld a, 13
	call CopyCardNameAndLevel
.print_text
	pop hl
	pop bc
	pop de
	push hl
	call InitTextPrinting
	pop hl
	push hl
	call .AppendCardListIndex
	call ProcessText
	ld hl, wDefaultText
	jr .asm_a76d

	; this code is never reached
	pop de
	push hl
	call InitTextPrinting
	ld hl, Text_9a36

.asm_a76d
	call ProcessText
	pop hl
	ld a, b
	dec a
	inc e
	inc e
	jr .loop_visible_cards

.handle_down_cursor
	ld de, wFilteredCardList
	add hl, hl
	add hl, de
	ld a, [hli]
	or [hl]
	jr z, .no_down_cursor
	pop de
	xor a ; FALSE
	ld [wUnableToScrollDown], a
	ld a, SYM_CURSOR_D
	jr .got_down_cursor_tile
.no_down_cursor
	pop de
	ld a, TRUE
	ld [wUnableToScrollDown], a
	ld a, SYM_BOX_BTM_R
.got_down_cursor_tile
	lb bc, 19, 17
	call WriteByteToBGMap0
	pop bc
	ret

.EmptySlotText
	textfw "-------------"
	done

; gets the index in the card list and adds it to wCurDeckName
.AppendCardListIndex
	push bc
	push de
	add hl, hl
	ld de, wFilteredCardList
	add hl, de
	dec hl
	dec hl
	ld a, [hli]
	ld e, a
	ld d, [hl]
	cp16 DOUBLE_COLORLESS_ENERGY + 1
	jr c, .energy_card
	cp16 VENUSAUR_LV64
	jr z, .phantom_card
	cp16 MEW_LV15
	jr z, .phantom_card

	ld a, [wNumVisibleCardListEntries]
	sub b ; zero-based row within this visible page
	ld c, a
	ld a, [wCardListVisibleOffset]
	add c
	ld l, a
	ld a, [wCardListVisibleOffsetHigh]
	adc 0
	ld h, a
	inc hl ; display indices are one-based
	call CalculateOnesAndTensDigits_Long
	ld hl, wDecimalDigitsSymbols + 1 ; skip ten-thousands digit
	ld de, wCurDeckName + 2 ; skip prefix
	call AppendFourDigitSymbols
	xor a ; SYM_SPACE
	ld [de], a
	inc de
	ld [de], a
	ld hl, wCurDeckName
	pop de
	pop bc
	ret

.energy_card
	ld h, d
	ld l, e
	call CalculateOnesAndTensDigits_Long
	ld hl, wDecimalDigitsSymbols
	ld a, [hli]
	ld b, a
	ld hl, wCurDeckName + 2
	ldfw de, "E"
	ld [hl], d
	inc hl
	ld [hl], e
	inc hl
	ld [hl], TX_SYMBOL
	inc hl
	ld a, SYM_0
	ld [hli], a
	ld [hl], TX_SYMBOL
	inc hl
	ld a, b
	ld [hli], a
	ld [hl], TX_SYMBOL
	inc hl
	xor a ; SYM_SPACE
	ld [hli], a
	ld [hl], a
	ld hl, wCurDeckName + 2
	pop de
	pop bc
	ret

.phantom_card
; phantom cards get only "××" in their index number
	ld hl, wCurDeckName + 2
	ldfw [hl], "×"
	inc hl
	ldfw [hl], "×"
	inc hl
	ld [hl], TX_SYMBOL
	inc hl
	xor a ; SYM_SPACE
	ld [hli], a
	ld [hl], a
	ld hl, wCurDeckName
	pop de
	pop bc
	ret

; handles opening card page, and inputs when inside Card Album
HandleCardAlbumCardPage:
	ld a, [wCardListCursorPos]
	ld c, a
	ld b, $00
	ld hl, wOwnedCardsCountList
	add hl, bc
	ld a, [hl]
	cp CARD_NOT_OWNED
	jr z, .handle_input

	ld hl, wCurCardListPtr
	ld a, [hli]
	ld h, [hl]
	ld l, a
	ld a, [wCardListCursorPos]
	sla a
	ld c, a
	ld b, $00
	add hl, bc
	ld e, [hl]
	inc hl
	ld d, [hl]
	push de
	call LoadCardDataToBuffer1_FromCardID
	lb de, $38, $9f
	call SetupText
	bank1call OpenCardPage_FromCheckHandOrDiscardPile
	pop de

.handle_input
	ldh a, [hDPadHeld]
	ld b, a
	and PAD_BUTTONS
	jp nz, .exit
	xor a ; FALSE
	ld [wMenuInputSFX], a
	ld a, [wCardListNumCursorPositions]
	ld c, a
	ld a, [wCardListCursorPos]
	bit B_PAD_UP, b
	jr z, .check_d_down

	push af
	ld a, SFX_CURSOR
	ld [wMenuInputSFX], a
	ld a, [wCardListVisibleOffset]
	ld b, a
	ld a, [wCardListCursorPos]
	add b
	ld l, a ; current absolute position low
	ld a, [wCardListVisibleOffsetHigh]
	adc 0
	ld h, a ; current absolute position high
	ld a, [wFirstOwnedCardIndex]
	cp l
	jr nz, .allow_page_up_check_high
	ld a, [wFirstOwnedCardIndexHigh]
	cp h
	jr z, .open_card_page_pop_af_2
.allow_page_up_check_high
	pop af

	dec a
	bit 7, a
	jr z, .got_new_pos
	ld a, [wCardListVisibleOffset]
	or a
	jr z, .page_up_borrow
	dec a
	ld [wCardListVisibleOffset], a
	ld hl, wCardListUpdateFunction
	call CallIndirect
	xor a
	jr .got_new_pos
.page_up_borrow
	ld a, [wCardListVisibleOffsetHigh]
	or a
	jr z, .open_card_page
	dec a
	ld [wCardListVisibleOffsetHigh], a
	ld a, $ff
	ld [wCardListVisibleOffset], a
	ld hl, wCardListUpdateFunction
	call CallIndirect
	xor a
	jr .got_new_pos

.check_d_down
	bit B_PAD_DOWN, b
	jr z, .asm_a8d6

	push af
	ld a, SFX_CURSOR
	ld [wMenuInputSFX], a
	pop af

	inc a
	cp c
	jr c, .got_new_pos
	push af
	ld hl, wCurCardListPtr
	ld a, [hli]
	ld h, [hl]
	ld l, a
	ld a, [wCardListCursorPos]
	sla a
	ld c, a
	ld b, $00
	add hl, bc
	inc hl
	inc hl
	ld a, [hli]
	or [hl]
	jr z, .open_card_page_pop_af_1
	ld a, [wCardListVisibleOffset]
	inc a
	ld [wCardListVisibleOffset], a
	jr nz, .page_down_offset_ready
	ld a, [wCardListVisibleOffsetHigh]
	inc a
	ld [wCardListVisibleOffsetHigh], a
.page_down_offset_ready
	ld hl, wCardListUpdateFunction
	call CallIndirect
	pop af
	dec a
.got_new_pos
	; loop back to the start
	ld [wCardListCursorPos], a
	ld a, [wMenuInputSFX]
	or a
	jp z, HandleCardAlbumCardPage
	call PlaySFX
	jp HandleCardAlbumCardPage
.open_card_page_pop_af_1
	pop af
	jr .open_card_page

.asm_a8d6
	ld a, [wced2]
	or a
	jr z, .open_card_page
	bit B_PAD_LEFT, b
	jr z, .check_d_right
	call RemoveCardFromDeck
	jr .open_card_page
.check_d_right
	bit B_PAD_RIGHT, b
	jr z, .open_card_page
	call TryAddCardToDeck

.open_card_page_pop_af_2
	pop af
.open_card_page
	push de
	bank1call OpenCardPage.input_loop
	pop de
	jp .handle_input

.exit
	ld a, $01
	ld [wVBlankOAMCopyToggle], a
	ld a, [wCardListCursorPos]
	ld [wTempCardListCursorPos], a
	ret

GetFirstOwnedCardIndex:
; wFirstOwnedCardIndex is filled during the full 16-bit set scan.
	ret

; Appends four already-converted decimal digit symbols from HL to DE,
; writing TX_SYMBOL before each digit. DE is returned at the next output byte.
AppendFourDigitSymbols:
	push bc
	ld b, 4
.loop
	ld a, TX_SYMBOL
	ld [de], a
	inc de
	ld a, [hli]
	ld [de], a
	inc de
	dec b
	jr nz, .loop
	pop bc
	ret

; Rebuild the current Card Album window when the user scrolls.
UpdateCardAlbumListWindow:
	push af
	push bc
	push de
	push hl
	ld a, [wSelectedCardSet]
	call CreateCardSetList
	call PrintCardSetListEntries
	pop hl
	pop de
	pop bc
	pop af
	ret

CardAlbum:
	xor a
	ld [wWindowedCardListMode], a
	ld [wCardListVisibleOffset], a
	ld [wCardListVisibleOffsetHigh], a
	ld a, $01
	ldh [hffb4], a

	xor a
.booster_pack_menu
	ld hl, .BoosterPackMenuParams
	call InitializeMenuParameters
	call .ShowBoosterPackMenu
.loop_input_1
	call DoFrame
	call HandleMenuInput
	jp nc, .loop_input_1 ; can be jr
	ldh a, [hCurMenuItem]
	cp $ff
	ret z

	; ignore input if this Card Set is unavailable
	ld c, a
	ld b, $0
	ld hl, wUnavailableAlbumCardSets
	add hl, bc
	ld a, [hl]
	or a
	jr nz, .loop_input_1

	ld a, c
	ld [wSelectedCardSet], a
	call CreateCardSetListAndInitListCoords
	ld a, TRUE
	ld [wWindowedCardListMode], a
	call .PrintCardCount
	xor a
	ld [wCardListVisibleOffset], a
	ld [wCardListVisibleOffsetHigh], a
	call PrintCardSetListEntries
	call EnableLCD
	ld a, [wNumEntriesInCurFilter]
	ld b, a
	ld a, [wNumEntriesInCurFilterHigh]
	or b
	jr nz, .asm_a968

.loop_input_2
	call DoFrame
	ldh a, [hKeysPressed]
	and PAD_B
	jr z, .loop_input_2
	ld a, $ff
	call PlaySFXConfirmOrCancel
	ldh a, [hCurMenuItem]
	jp .booster_pack_menu

.asm_a968
	call .GetNumCardEntries
	xor a
	ld hl, .BoosterPackCardsMenuParams
	call InitCardSelectionParams
	ld a, [wNumEntriesInCurFilterHigh]
	or a
	jr nz, .asm_a97e
	ld a, [wNumEntriesInCurFilter]
	ld hl, wNumVisibleCardListEntries
	cp [hl]
	jr nc, .asm_a97e
	ld [wCardListNumCursorPositions], a
.asm_a97e
	ld hl, UpdateCardAlbumListWindow
	ld d, h
	ld a, l
	ld hl, wCardListUpdateFunction
	ld [hli], a
	ld [hl], d

	xor a
	ld [wced2], a
.loop_input_3
	call DoFrame
	call HandleDeckCardSelectionList
	jr c, .selection_made
	call HandleLeftRightInCardList
	jr c, .loop_input_3
	ldh a, [hDPadHeld]
	and PAD_START
	jr z, .loop_input_3
.open_card_page
	ld a, $01
	call PlaySFXConfirmOrCancel
	ld a, [wCardListNumCursorPositions]
	ld [wTempCardListNumCursorPositions], a
	ld a, [wCardListCursorPos]
	ld [wTempCardListCursorPos], a
	ld c, a
	ld a, [wCardListVisibleOffset]
	add c
	ld hl, wOwnedCardsCountList
	ld c, a
	ld b, $00
	add hl, bc
	ld a, [hl]
	cp CARD_NOT_OWNED
	jr z, .loop_input_3

	; set wFilteredCardList as current card list
	ld de, wFilteredCardList
	ld hl, wCurCardListPtr
	ld [hl], e
	inc hl
	ld [hl], d

	call GetFirstOwnedCardIndex
	call HandleCardAlbumCardPage
	call .PrintCardCount
	call PrintCardSetListEntries
	call EnableLCD
	ld hl, .BoosterPackCardsMenuParams
	call InitCardSelectionParams
	ld a, [wTempCardListNumCursorPositions]
	ld [wCardListNumCursorPositions], a
	ld a, [wTempCardListCursorPos]
	ld [wCardListCursorPos], a
	jr .loop_input_3

.selection_made
	call DrawListCursor_Invisible
	ld a, [wCardListCursorPos]
	ld [wTempCardListCursorPos], a
	ldh a, [hffb3]
	cp $ff
	jr nz, .open_card_page
	ldh a, [hCurMenuItem]
	jp .booster_pack_menu

.BoosterPackMenuParams:
	db 3, 3 ; cursor x, cursor y
	db 2 ; y displacement between items
	db 5 ; number of items
	db SYM_CURSOR_R ; cursor tile number
	db SYM_SPACE ; tile behind cursor
	dw NULL ; function pointer if non-0

.BoosterPackCardsMenuParams:
	db 1 ; x pos
	db 4 ; y pos
	db 2 ; y spacing
	db 0 ; x spacing
	db NUM_CARD_ALBUM_VISIBLE_CARDS ; num entries
	db SYM_CURSOR_R ; visible cursor tile
	db SYM_SPACE ; invisible cursor tile
	dw NULL ; wCardListHandlerFunction

.GetNumCardEntries
	ld a, [wNumEntriesInCurFilter]
	ld [wNumCardListEntries], a
	ld a, [wNumEntriesInCurFilterHigh]
	ld [wNumCardListEntriesHigh], a
	ret

; prints "X/Y" where X is number of cards owned in the set
; and Y is the total card count of the Card Set
.PrintCardCount
	call Set_OBJ_8x8
	xor a
	ld [wTileMapFill], a
	call ZeroObjectPositions
	call EmptyScreen
	ld a, $01
	ld [wVBlankOAMCopyToggle], a
	call LoadCursorTile
	call LoadSymbolsFont
	call LoadDuelCardSymbolTiles
	bank1call SetDefaultConsolePalettes
	lb de, $3c, $ff
	call SetupText
	lb de, 1, 1
	call InitTextPrinting

; print the total number of cards that are in the Card Set
	ld a, [wSelectedCardSet]
	cp CARD_SET_PROMOTIONAL
	jr nz, .check_laboratory
; promotional
	ldtx hl, Item5PromotionalCardText
	ld e, NUM_CARDS_PROMOTIONAL - 2 ; minus the phantom cards
	ld a, [wOwnedPhantomCardFlags]
	bit VENUSAUR_OWNED_PHANTOM_F, a
	jr z, .check_owns_mew
	inc e
.check_owns_mew
	bit MEW_OWNED_PHANTOM_F, a
	jr z, .has_card_set_count
	inc e
	jr .has_card_set_count
.check_laboratory
	cp CARD_SET_LABORATORY
	jr nz, .check_mystery
	ldtx hl, Item4LaboratoryText
	ld e, NUM_CARDS_LABORATORY
	jr .has_card_set_count
.check_mystery
	cp CARD_SET_MYSTERY
	jr nz, .check_evolution
	ldtx hl, Item3MysteryText
	ld e, NUM_CARDS_MYSTERY
	jr .has_card_set_count
.check_evolution
	cp CARD_SET_EVOLUTION
	jr nz, .colosseum
	ldtx hl, Item2EvolutionText
	ld e, NUM_CARDS_EVOLUTION
	jr .has_card_set_count
.colosseum
	ldtx hl, Item1ColosseumText
	ld e, NUM_CARDS_COLOSSEUM

.has_card_set_count
	push de ; legacy fixed set count, no longer used for the denominator
	call ProcessTextFromID
	call .CountOwnedCardsInSet
	pop de
	lb de, 10, 1
	call InitTextPrinting

; numerator: all owned cards in this set (16-bit)
	ld a, [wNumOwnedCardsInSet]
	ld l, a
	ld a, [wNumOwnedCardsInSetHigh]
	ld h, a
	call CalculateOnesAndTensDigits_Long
	ld hl, wDecimalDigitsSymbols + 1
	ld de, wDefaultText
	call AppendFourDigitSymbols
	ld a, TX_SYMBOL
	ld [de], a
	inc de
	ld a, SYM_SLASH
	ld [de], a
	inc de

; denominator: all card IDs assigned to this set (16-bit)
	push de ; preserve the current destination in wDefaultText
	ld a, [wNumCardsInSet]
	ld l, a
	ld a, [wNumCardsInSetHigh]
	ld h, a
	call CalculateOnesAndTensDigits_Long
	ld hl, wDecimalDigitsSymbols + 1
	pop de
	call AppendFourDigitSymbols
	ld a, TX_END
	ld [de], a
	ld hl, wDefaultText
	call ProcessText
	lb de, 0, 2
	lb bc, 20, 16
	call DrawRegularTextBox
	jp EnableLCD

; counts number of cards in wOwnedCardsCountList
; that is not set as CARD_NOT_OWNED
.CountOwnedCardsInSet
; wNumOwnedCardsInSet was counted across the full set by AppendCardSetEntry.
	ret

.ShowBoosterPackMenu:
	xor a
	ld [wTileMapFill], a
	call EmptyScreen
	ldh a, [hffb4]
	dec a
	jr nz, .draw_box
	ldh [hffb4], a
	call Set_OBJ_8x8
	call ZeroObjectPositions
	ld a, $01
	ld [wVBlankOAMCopyToggle], a

	call LoadCursorTile
	call LoadSymbolsFont
	call LoadDuelCardSymbolTiles
	bank1call SetDefaultConsolePalettes
	lb de, $3c, $ff
	call SetupText

.draw_box
	lb de, 0, 0
	lb bc, 20, 13
	call DrawRegularTextBox
	ld hl, .BoosterPacksMenuData
	call PlaceTextItems

	; set all Card Sets as available
	ld a, NUM_CARD_SETS
	ld hl, wUnavailableAlbumCardSets
	call ClearMemory_Bank2

	; check whether player has had promotional cards
	call EnableSRAM
	ld a, [sHasPromotionalCards]
	call DisableSRAM
	or a
	jr nz, .has_promotional

	; doesn't have promotional, check if
	; this is still the case by checking the collection
	ld a, CARD_SET_PROMOTIONAL
	call CreateCardSetListAndInitListCoords
	ld hl, wFilteredCardList
	ld a, [hli]
	or [hl]
	jr nz, .set_has_promotional
	; still has no promotional, print empty Card Set name
	ld a, TRUE
	ld [wUnavailableAlbumCardSets + CARD_SET_PROMOTIONAL], a
	lb de, 5, 11
	call InitTextPrinting
	ldtx hl, EmptyPromotionalCardText
	call ProcessTextFromID
	jr .has_promotional

.set_has_promotional
	call EnableSRAM
	ld a, TRUE
	ld [sHasPromotionalCards], a
	call DisableSRAM
.has_promotional
	ldtx hl, ViewWhichCardFileText
	call DrawWideTextBox_PrintText
	jp EnableLCD

.BoosterPacksMenuData
	textitem 7,  1, BoosterPackTitleText
	textitem 5,  3, Item1ColosseumText
	textitem 5,  5, Item2EvolutionText
	textitem 5,  7, Item3MysteryText
	textitem 5,  9, Item4LaboratoryText
	textitem 5, 11, Item5PromotionalCardText
	db $ff
